      <aliases enabled='yes' />
      <column datatype='string' name='[Audience Emotion]' role='dimension' type='nominal' />
      <column caption='Total Post' datatype='integer' name='[Calculation_2361531469197312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Post Date])' />
      </column>
      <column caption='Total Engagements' datatype='integer' name='[Calculation_2361531469393921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Likes])+ ZN([Comments])+ ZN([Shares])+ ZN([Saves])' />
      </column>
      <column caption='Engagement Rate by Reach' datatype='real' name='[Calculation_2361531469643778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Reach])=0 THEN 0&#13;&#10;ELSE&#13;&#10;   SUM([Calculation_2361531469393921])/SUM([Reach])&#13;&#10;END' />
      </column>
      <column caption='Engagement Rate by Impressions' datatype='real' name='[Calculation_2361531470176259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Impressions])=0 THEN 0&#13;&#10;ELSE &#13;&#10;   SUM([Calculation_2361531469393921])/SUM([Impressions])&#13;&#10;END' />
      </column>
      <column caption='Average Reach Per Post' datatype='real' name='[Calculation_2361531470659588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Reach])' />
      </column>
      <column caption='Average Enagements Per Post' datatype='real' name='[Calculation_2361531471400965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_2361531469393921])' />
      </column>
      <column caption='Avg Impression per Reached Account' datatype='real' name='[Calculation_2361531474206726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Reach])= 0 THEN 0 &#13;&#10;ELSE SUM([Impressions])/SUM([Reach])&#13;&#10;END' />
      </column>
      <column caption='Profile visit Rate' datatype='real' name='[Calculation_2361531474718727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Reach]) = 0 THEN 0&#13;&#10;ELSE SUM([Profile Visits]) / SUM([Reach])&#13;&#10;END' />
      </column>
      <column caption='Follow Conversion Rate' datatype='real' name='[Calculation_2361531475300360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Profile Visits]) = 0 THEN 0&#13;&#10;ELSE SUM([Follows]) / SUM([Profile Visits])&#13;&#10;END' />
      </column>
      <column caption='Share Rate' datatype='real' name='[Calculation_2361531475374089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Reach]) = 0 THEN 0&#13;&#10;ELSE SUM([Shares]) / SUM([Reach])&#13;&#10;END' />
      </column>
      <column caption='Save Rate' datatype='real' name='[Calculation_2361531475435530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Reach]) = 0 THEN 0&#13;&#10;ELSE SUM([Saves]) / SUM([Reach])&#13;&#10;END' />
      </column>
      <column caption='Month-Year' datatype='datetime' name='[Calculation_2361531475525643]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Post Date])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_2361531475972108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Post Date])' />
      </column>
      <column caption='Engagement Category' datatype='string' name='[Calculation_2361531476230158]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2361531477295119] &gt;= 0.20 THEN &quot;High&quot;&#13;&#10;ELSEIF [Calculation_2361531477295119] &gt;= 0.10 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Engagement Rate %' datatype='real' name='[Calculation_2361531477295119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2361531469643778]+[Calculation_2361531470176259]' />
      </column>
