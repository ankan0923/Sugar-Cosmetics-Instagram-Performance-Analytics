      <size maxheight='571' maxwidth='1157' minheight='571' minwidth='1000' sizing-mode='range' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97198' id='10' param='vert' removable='false' type-v2='layout-flow' w='98618' x='691' y='1401'>
            <zone h='97198' id='7' param='vert' removable='false' type-v2='layout-flow' w='98618' x='691' y='1401'>
              <zone h='97198' id='1' param='vert' removable='false' type-v2='layout-flow' w='98618' x='691' y='1401'>
                <zone h='13835' id='4' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98618' x='691' y='1401' />
                <zone h='83363' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98618' x='691' y='15236'>
                  <flipboard active-id='8' nav-type='arrowonly' show-nav-arrows='true'>
                    <story-points>
                      <story-point captured-sheet='Trend Chart' id='2' />
